# Copy to .env.local (git-ignored). Never commit real values.
# Firebase Web SDK config is not secret, but it identifies a project:
# keep DEV and PROD values apart and never point a test build at PROD.

VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=REPLACE_ME.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=REPLACE_ME
VITE_FIREBASE_STORAGE_BUCKET=REPLACE_ME.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME

# "dev" | "prod" — Firebase client wiring must refuse to start if this is unset.
VITE_BINI_ENV=dev
VITE_BINI_PROPERTY_ID=property-main

# App Check reCAPTCHA Enterprise site key (public, score-based). Register the same site key in Firebase App Check.
VITE_RECAPTCHA_SITE_KEY=REPLACE_ME

# Set to "1" to point the web shell at the local emulator suite.
VITE_USE_EMULATORS=1
