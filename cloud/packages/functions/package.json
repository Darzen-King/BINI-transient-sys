{
  "name": "@bini/cloud-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud Functions operation processor for BINI PMS v4 (foundation skeleton).",
  "main": "./dist/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -b && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist/index.js --external:firebase-admin --external:firebase-admin/* --external:firebase-functions --external:firebase-functions/*",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.2.0",
    "zod": "^3.24.1"
  }
}
